{
  "name": "marcacion-cd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Marcación de entrada y salida para la seguridad de los Centros de Distribución",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-marcacion \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-marcacion",
    "seed": "node scripts/seed-emulator.mjs",
    "e2e": "firebase emulators:exec --only firestore,auth --project demo-marcacion \"playwright test\"",
    "test:avisos": "firebase emulators:exec --only firestore --project demo-marcacion \"vitest run --config vitest.avisos.config.ts\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.6",
    "signature_pad": "^5.1.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.36.0",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  }
}
