# Configuración PÚBLICA de la app web de Firebase (no es secreta, pero no la subas al repo:
# va en los secretos de GitHub con estos mismos nombres).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Solo para desarrollo local con el emulador: "true"
VITE_USE_EMULATOR=
